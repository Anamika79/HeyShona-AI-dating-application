# Project Metadata
PROJECT_NAME="AI Dating Platform API"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# Database Configuration
# Default: Local SQLite
DATABASE_URL="sqlite:///./dating_platform.db"
# For PostgreSQL migration:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dating_platform"

# Security & CORS
# JSON list of allowed origins or comma-separated origins
BACKEND_CORS_ORIGINS='["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]'

# Gemini API Configuration (Google GenAI)
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Keep strictly on backend - NEVER expose this key to the frontend client
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_SECONDS=60
